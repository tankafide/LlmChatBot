{
  "name": "autoassist-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "api:generate": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check",
    "test": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format-check && npm run api:check && npm run build && npm test"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.18",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "6.4.3"
  }
}
